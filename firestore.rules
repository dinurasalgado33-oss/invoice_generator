rules_version = '2';

// Leopard Inn — Firestore security rules.
//
// The whole security boundary lives here. The app's config is public and
// its code is readable, so nothing may depend on a screen hiding a button:
// a rule has to be able to answer "may this signed-in person read this
// record" on its own.
//
// Who someone is comes from users/{uid} — a document holding their role
// and, for staff, the one property they work at. That document is readable
// by them and writable by nobody from the app, so a receptionist cannot
// promote themselves by editing their own row.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Who is asking
    // ---------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isManager() {
      return hasProfile() && profile().role == 'manager' && profile().active == true;
    }

    function isStaff() {
      return hasProfile() && profile().role == 'staff' && profile().active == true;
    }

    function worksHere(branch) {
      return isManager() || (isStaff() && profile().branch == branch);
    }

    // A record already stored, and one being written. Both have to be
    // checked on an update: without the first, a staff member could take
    // another property's record and rewrite its branch to their own.
    function mayTouchExisting() {
      return resource != null && worksHere(resource.data.branch);
    }

    function mayWriteIncoming() {
      return request.resource != null && worksHere(request.resource.data.branch);
    }

    // ---------------------------------------------------------------
    // Staff directory
    // ---------------------------------------------------------------
    // Readable by the person it describes (the app needs to know its own
    // role) and by managers (the staff screen lists them). Written only by
    // a Cloud Function using the Admin SDK, which these rules do not
    // apply to — so nobody can change their own role or branch.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // The guest-facing menu
    // ---------------------------------------------------------------
    // Two collections the world may read without signing in, because a QR
    // code on a table has nobody signed in behind it. Scoped to these
    // alone and nothing else — the same database holds passport and NIC
    // numbers, and a broader public rule would expose them.
    //
    // The list of published menu PDFs, read by the public menu page at
    // /menu.html.
    //
    // It lives here rather than beside the PDFs in Storage because a
    // browser cannot fetch a Storage object cross-origin without CORS
    // configured on the bucket, and configuring that needs gcloud. A
    // Firestore read has none of that trouble, and the PDFs themselves are
    // opened by ordinary link navigation, which CORS does not touch.
    //
    // It holds four links and two hotel names. Nothing here is a secret.
    match /publicMenus/{id} {
      allow read: if true;
      allow write: if isManager();
    }

    // The dishes themselves. Still public: the PDFs are what a guest is
    // pointed at now, but this is what any future live menu page would
    // read, and it was opened for that reason before the PDFs existed.
    match /menuItems/{item} {
      allow read: if true;
      allow create, update: if isManager();
      allow delete: if isManager();
    }

    // No /rooms rule, deliberately. Villa names and nightly rates are
    // config — `config/<branch>__villas`, ruled below — and whether a villa
    // is occupied is derived from the bookings rather than stored at all.
    // This rule existed for a collection nothing ever read or wrote. An
    // open door onto an empty room is still an open door, and a rule that
    // describes something the app does not do reads, to the next person,
    // as a description of something it does.

    // ---------------------------------------------------------------
    // Money — nothing financial is ever deleted
    // ---------------------------------------------------------------
    // An invoice may be created by whoever works at that property, and
    // afterwards only voided, and only by a manager. It can never be
    // removed: a bill that vanishes is the one thing books must not allow.
    match /invoices/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if isManager() && mayTouchExisting();
      allow delete: if false;
    }

    match /proformaInvoices/{id} {
      allow read: if mayTouchExisting();
      // Split, because create and update are not the same question.
      // mayTouchExisting() asks about `resource`, the document already
      // stored — and on a create there isn't one, so it is always false.
      // Collapsing the two onto one line therefore refused every create
      // this collection has ever seen: the travel agent invoice rendered,
      // took a number, and was never saved. Nothing errored on screen.
      // Every other collection here splits them; this was the only one
      // that did not.
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // The stay, and everything filed against it
    // ---------------------------------------------------------------
    // Registration cards carry passport and NIC numbers, so they follow
    // the same property scoping as everything else and are never deleted —
    // they are the record the law requires the hotel to keep.
    match /registrationCards/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    match /bookings/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    match /reservations/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    // A guest's charges. Marked billed or written off, never removed, so a
    // bill can always be traced back to what made it up.
    match /guestCharges/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    match /foodOrders/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    // The kitchen queue, as opposed to foodOrders above, which is the sale.
    //
    // These two are deliberately different collections with deliberately
    // different delete rules. A pending order is a work item: it is keyed
    // in wrongly, it is cancelled before the kitchen starts, and reception
    // has to be able to take it back off the list. The moment it is
    // completed a foodOrders record is written, and *that* is the money —
    // undeletable, like every other financial record here.
    //
    // Deleting is staff, not manager: the person who mistyped the order is
    // the person standing at the counter, and a rule that made them find a
    // manager would just push them to leave it pending forever.
    match /foodOrdersPending/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if mayTouchExisting();
    }

    match /activityCharges/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if mayWriteIncoming() && mayTouchExisting();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Stock
    // ---------------------------------------------------------------
    match /restocks/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if isManager() && mayTouchExisting();
      allow delete: if false;
    }

    match /stockUsage/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if isManager() && mayTouchExisting();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Logs and queues
    // ---------------------------------------------------------------
    // The welcome e-mail queue. The app adds rows; the Function that sends
    // them marks each sent or failed with the Admin SDK, which bypasses
    // these rules — so nothing here needs to let a client claim a send.
    match /guestEmails/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if false;
      allow delete: if false;
    }

    // The guest's bill. Same shape as guestEmails: the app adds a row and
    // the Function that sends it marks it with the Admin SDK, which these
    // rules do not apply to — so nothing here needs to let a client claim
    // a send. Never updated or deleted from the app: it carries a copy of
    // a financial document.
    match /invoiceEmails/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update: if false;
      allow delete: if false;
    }

    match /roomActivity/{id} {
      allow read: if mayTouchExisting();
      allow create: if mayWriteIncoming();
      allow update, delete: if false;
    }

    // Sign-ins are a manager's audit trail, so a member of staff may add
    // to it but not read it back or alter it.
    match /logins/{id} {
      allow read: if isManager();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // Crash reports. Anyone signed in may file one — the app writes these
    // itself when something breaks — and only a manager reads them.
    match /errors/{id} {
      allow read: if isManager();
      allow create: if signedIn();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Document numbering
    // ---------------------------------------------------------------
    // One counter per property, document type and financial year. A device
    // reserves a block of numbers from it and spends them offline, so this
    // is the only place in the app that needs real coordination.
    //
    // Anyone signed in may reserve a block, because reception has to be
    // able to bill. Nobody may delete one: losing a counter would restart
    // a series and hand out numbers that already exist on paper.
    match /counters/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // Manager-set configuration
    // ---------------------------------------------------------------
    // Villa rates, activities, the service charge, VAT, bank details and
    // the printed policies. Readable by anyone signed in, because every
    // screen bills and prints from these. Writable only by a manager: a
    // nightly rate and a VAT percentage decide what a guest is charged,
    // which makes them exactly as financial as an invoice — they are
    // simply financial before the bill rather than after it.
    //
    // Deletable by a manager too, unlike the financial collections. A
    // discontinued activity or a retired policy line is config being
    // tidied, not a record being erased; the invoices that used them
    // keep their own snapshot of what they said at the time.
    // What reception has actually typed into the free-text fields — guide
    // names, travel agents, countries — offered back as suggestions so the
    // same person does not become three records under three spellings.
    //
    // Writable by anyone signed in, unlike config, and that is the whole
    // reason it is not in config: the people who type these names are
    // staff. Nothing here is financial and nothing is read back into a
    // document; the worst a bad write can do is offer a silly suggestion,
    // against a real name that is retyped and re-learned immediately.
    match /suggestions/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isManager();
    }

    match /config/{id} {
      allow read: if signedIn();
      allow create, update: if isManager();
      allow delete: if isManager();
    }

    // ---------------------------------------------------------------
    // Anything not named above
    // ---------------------------------------------------------------
    // Denied. A new collection has to be granted access deliberately
    // rather than inheriting it, so adding one cannot quietly open a hole.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
